{
  "name": "knowledge-vault",
  "private": true,
  "version": "1.2.0",
  "author": {
    "name": "Knowledge Vault",
    "email": "dev@knowledge-vault.app"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "electron:start": "electron electron/main.js",
    "build:exe": "npm run build && npx electron-builder --win --publish never",
    "build:linux": "npm run build && npx electron-builder --linux --publish never",
    "build:apk": "npm run build && npx cap sync android"
  },
  "build": {
    "appId": "com.knowledgevault.app",
    "productName": "Knowledge Vault",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@lezer/markdown": "^1.7.2",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0",
    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "cors": "^2.8.5",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "express": "^4.18.2",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "ws": "^8.16.0"
  }
}
